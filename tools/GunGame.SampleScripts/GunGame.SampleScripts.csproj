<Project Sdk="Microsoft.NET.Sdk">

  <!-- 게임 스크립트 작성 예제이자 플레이어 스크립팅 테스트용 스크립트 모음. 결과를 build\bin\scripts\에 복사한다. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <GgeBinDir>$(MSBuildThisFileDirectory)..\..\build\bin\</GgeBinDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GunGame.Scripting\GunGame.Scripting.csproj" />
  </ItemGroup>

  <Target Name="CollectSampleScripts" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)GunGame.SampleScripts.dll;$(OutDir)GunGame.SampleScripts.pdb" DestinationFolder="$(GgeBinDir)scripts\" />
  </Target>

</Project>
