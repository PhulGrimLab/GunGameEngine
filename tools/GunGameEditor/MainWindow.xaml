<Window x:Class="GunGameEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GunGame Editor" Height="680" Width="1180"
        Loaded="OnLoaded" Closed="OnClosed">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="FileBar">
                <Button Content="New" Click="OnNewScene" />
                <Button Content="Open Scene..." Click="OnOpenScene" />
                <Button Content="Save" Click="OnSaveScene" />
                <Button Content="Save As..." Click="OnSaveSceneAs" />
            </ToolBar>
            <ToolBar x:Name="NodeBar">
                <Button Content="Add Mesh..." Click="OnAddMesh" />
                <Button Content="Add Group" Click="OnAddGroup" />
                <Button Content="Delete" Click="OnDelete" />
                <Button Content="OBJ to GGM..." Click="OnConvertObj" />
            </ToolBar>
            <ToolBar x:Name="PlayBar">
                <Button x:Name="PlayButton" Content="Play" Click="OnPlayToggle" />
                <CheckBox x:Name="GameplayCheck" Content="Show gameplay" Click="OnGameplayOverlayChanged" />
            </ToolBar>
            <ToolBar>
                <CheckBox x:Name="SnapCheck" Content="Vertex snap" IsChecked="True" Click="OnRetroChanged" />
                <CheckBox x:Name="BitsCheck" Content="15-bit color" IsChecked="True" Click="OnRetroChanged" />
                <CheckBox x:Name="DitherCheck" Content="Dither" IsChecked="True" Click="OnRetroChanged" />
                <CheckBox x:Name="AffineCheck" Content="Affine texture" IsChecked="True" Click="OnRetroChanged" />
            </ToolBar>
        </ToolBarTray>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="GameplayBar">
                <Button Content="Add Room" Click="OnAddRoom" />
                <Button Content="Add Collider" Click="OnAddCollider" />
                <Button Content="Add Trigger" Click="OnAddTrigger" />
                <Button Content="Add Light" Click="OnAddLight" />
                <Button Content="Set Player" Click="OnSetPlayer" />
                <Button Content="Delete Item" Click="OnDeleteGameplayItem" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Drag: orbit, Wheel: zoom" />
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="60" />
                </Grid.RowDefinitions>
                <TreeView x:Name="Hierarchy" Grid.Row="0" AllowDrop="True"
                          SelectedItemChanged="OnSelectionChanged"
                          PreviewMouseLeftButtonDown="OnTreeMouseDown" PreviewMouseMove="OnTreeMouseMove"
                          DragOver="OnTreeDragOver" Drop="OnTreeDrop">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
                <ListBox x:Name="GameplayList" Grid.Row="2" DisplayMemberPath="Display"
                         SelectionChanged="OnGameplaySelectionChanged" />
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Background="Black">
                <Image x:Name="Viewport" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseLeftButtonDown="OnMouseDown" MouseLeftButtonUp="OnMouseUp"
                       MouseMove="OnMouseMove" MouseWheel="OnMouseWheel" />
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel xmlns:local="clr-namespace:GunGameEditor">
                    <local:InspectorPanel x:Name="Inspector" />
                    <local:GameplayInspector x:Name="GameplayInspectorPanel" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
